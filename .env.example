# ============================================
# GAIA RECS - CONFIGURACIÓN DE ENTORNO
# ============================================

# BACKEND CONFIGURATION
# =====================

# Solana Network Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com (producción)
# SOLANA_RPC_URL=http://localhost:8899 (local validator)

# Wallet Configuration
ADMIN_WALLET_PATH=/home/ilich/.config/solana/id.json
# O usar variable de entorno para la clave privada:
# ADMIN_PRIVATE_KEY=[64_CHAR_HEX_STRING]

# Program and Token Addresses
PROGRAM_ID=GAIA_RECS_PROGRAM_ID  # Reemplazar con address real después de deploy
GAIA_REC_TOKEN_MINT=TOKEN_MINT_ADDRESS  # Reemplazar con address real del mint

# Oracle Configuration
ORACLE_PRIVATE_KEY=oracle_private_key_here  # Para firma de reportes
ORACLE_PUBLIC_KEY=oracle_public_key_here

# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# Database Configuration (si se usa)
DATABASE_URL=postgresql://user:password@localhost:5432/gaia_recs
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=your_jwt_secret_key_here
API_KEY=your_api_key_here
CORS_ORIGIN=http://localhost:3000

# ============================================

# FRONTEND CONFIGURATION
# ======================

# Solana Network (para frontend)
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_SOLANA_WS_URL=wss://api.devnet.solana.com

# Program and Token Addresses (deben coincidir con backend)
VITE_PROGRAM_ID=GAIA_RECS_PROGRAM_ID
VITE_TOKEN_MINT=TOKEN_MINT_ADDRESS

# Backend API
VITE_API_URL=http://localhost:3001
VITE_API_TIMEOUT=30000

# Feature Flags
VITE_ENABLE_DEV_TOOLS=true
VITE_ENABLE_LOGGING=true

# UI Configuration
VITE_APP_NAME="Gaia Renewable Energy Credits"
VITE_APP_DESCRIPTION="Tokenized Renewable Energy Certificates on Solana"
VITE_APP_VERSION=1.0.0

# ============================================

# DEPLOYMENT NOTES:
# 1. Copiar este archivo a .env en backend/ y frontend/
# 2. Reemplazar los valores entre [] con tus configuraciones reales
# 3. NUNCA subir archivos .env a GitHub
# 4. Para producción, usar variables de entorno del servidor

# ============================================
# CONFIGURACIÓN POR ENTORNO
# ============================================

# Desarrollo (default)
# NODE_ENV=development
# LOG_LEVEL=debug
# CORS_ORIGIN=http://localhost:3000

# Testing
# NODE_ENV=test
# LOG_LEVEL=error
# DATABASE_URL=postgresql://user:password@localhost:5432/gaia_recs_test

# Producción
# NODE_ENV=production
# LOG_LEVEL=warn
# CORS_ORIGIN=https://gaia-ecotrack.vercel.app
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com